{
  "name": "reviva-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI Front Desk Employee Platform for Med Spas",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "db:lint": "supabase db lint --local --level error",
    "db:reset": "supabase db reset --local",
    "db:test": "pnpm --filter @reviva/postgres test:integration",
    "lint": "turbo lint",
    "supabase:status": "supabase status",
    "test": "turbo test",
    "format": "turbo format"
  },
  "devDependencies": {
    "supabase": "2.109.1",
    "turbo": "^2.5.6"
  }
}
