# Public canonical origin with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://reviva.example

# Supabase project values safe for browser use. Never use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-development-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-key

# Restricted reviva_app connection. Server-only; store it in the host secret manager.
REVIVA_DB_RUNTIME_URL=postgresql://reviva_app:password@development-pooler:6543/postgres

# Hosted Auth integration test only. Use a fake Development user; never commit values.
REVIVA_AUTH_TEST_EMAIL=fake-auth-user@example.test
REVIVA_AUTH_TEST_PASSWORD=replace-with-a-local-development-password
REVIVA_DB_ENVIRONMENT=development
REVIVA_DB_TEST_PROJECT_REF=replace-with-development-project-ref
REVIVA_DB_PRODUCTION_PROJECT_REF=replace-with-production-project-ref-if-one-exists

# HTTPS endpoint that accepts the early_access.requested webhook contract.
LEAD_WEBHOOK_URL=https://hooks.example.com/reviva/early-access

# Required bearer credential sent only from the server to the webhook.
LEAD_WEBHOOK_SECRET=replace-with-a-secret-managed-by-the-host

# Exact browser origin allowed to submit the public lead form.
LEAD_ALLOWED_ORIGIN=https://reviva.example
