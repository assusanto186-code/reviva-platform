    "test:integration": "tsc -p tsconfig.json && node --test test/postgres.integration.test.mjs"
  },
  "dependencies": {
    "@reviva/domain": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
