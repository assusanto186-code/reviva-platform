# Direct Development database connection used only for migrations and tests.
REVIVA_DB_ADMIN_URL=postgresql://user:password@development-host:5432/postgres

# Restricted Development runtime connection through the transaction pooler.
REVIVA_DB_RUNTIME_URL=postgresql://reviva_app:password@development-pooler:6543/postgres

# Required destructive-test safeguards. Never set these for Production.
REVIVA_DB_ENVIRONMENT=development
REVIVA_DB_TEST_PROJECT_REF=replace-with-development-project-ref
REVIVA_DB_PRODUCTION_PROJECT_REF=replace-with-production-project-ref-if-one-exists
REVIVA_DB_ALLOW_DESTRUCTIVE_TESTS=reviva-development-only
